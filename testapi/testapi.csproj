<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <FrontendWorkingDir>$(MSBuildProjectDirectory)\..\Business.Translations.FrontEnd</FrontendWorkingDir>
  </PropertyGroup>

  <Target Name="BuildFrontend" BeforeTargets="Build;Publish">
    <Exec WorkingDirectory="$(FrontendWorkingDir)" Command="npm run build" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="../Business.Translations.API/Business.Translations.API.csproj" />
    <!-- <PackageReference Include="BusinessTranslations" Version="1.0.3" /> -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
  </ItemGroup>
</Project>
