<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>BusinessTranslations</PackageId>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <Description>ASP.NET Core package that adds a translations (i18n) management dashboard and REST API to your application — CRUD for translations, modules and languages, automatic table creation, and an embedded React dashboard.</Description>
    <Authors>arr199</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.MD</PackageReadmeFile>
    <PackageTags>i18n;localization;translations;dashboard;aspnetcore</PackageTags>
    <RepositoryUrl>https://github.com/arr199/BusinessTranslations</RepositoryUrl>
    <PackageProjectUrl>https://github.com/arr199/BusinessTranslations</PackageProjectUrl>
    <ReleaseNotes>Initial release: translations management dashboard, CRUD REST API for translations/modules/languages, SQL Server provider, CSV export/import with bulk upsert.</ReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.MD" Pack="true" PackagePath="/" Link="README.MD" />
  </ItemGroup>

  <ItemGroup>
    <FrameWorkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../Business.Translations.FrontEnd/Business.Translations.FrontEnd.csproj" PrivateAssets="All" />
  </ItemGroup>

  <!-- Embeds the FrontEnd dashboard into the assembly so the NuGet package ships it. -->
  <Target Name="BuildDashboard" BeforeTargets="PrepareForBuild" Condition="'$(BuildDashboardExecuted)' != 'true'">
    <Exec Command="pnpm run build" WorkingDirectory="$(MSBuildThisFileDirectory)../Business.Translations.FrontEnd" />
    <ItemGroup>
      <EmbeddedResource Include="..\Business.Translations.FrontEnd\dist\**\*" KeepDuplicates="false" />
    </ItemGroup>
    <ItemGroup>
      <EmbeddedResource Link="dist\%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
    <PropertyGroup>
      <BuildDashboardExecuted>true</BuildDashboardExecuted>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.3" />
  </ItemGroup>
</Project>

